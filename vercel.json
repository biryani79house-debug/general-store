{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "payment.html",
      "use": "@vercel/static"
    },
    {
      "src": "sales.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/payment",
      "dest": "/payment.html"
    },
    {
      "src": "/sales",
      "dest": "/sales.html"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ],
  "regions": ["sin1"]
}
